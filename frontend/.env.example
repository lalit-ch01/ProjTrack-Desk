# Environment Configuration Template
# Copy this file to .env.local and fill in your values for local development
# For different environments, create .env.staging, .env.production, etc.

# API Configuration
# This is the base URL for all API calls
# Change this single value to switch between different backend environments
VITE_API_BASE_URL=http://localhost:8000

# App Configuration
VITE_APP_NAME=ProjTrack
VITE_ENV=development

# Feature Flags
VITE_ANALYTICS_ENABLED=false
VITE_ERROR_REPORTING=false

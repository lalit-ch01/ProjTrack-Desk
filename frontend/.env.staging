# Staging Environment Configuration
# Set these variables in Vercel dashboard for staging deployment
# Only change VITE_API_BASE_URL for different backend environments

VITE_API_BASE_URL=https://staging-api.projtrack.com
VITE_APP_NAME=ProjTrack Staging
VITE_ENV=staging
VITE_ANALYTICS_ENABLED=true
VITE_ERROR_REPORTING=true
